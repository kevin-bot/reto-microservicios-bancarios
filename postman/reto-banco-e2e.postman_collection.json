    {
      "name": "5. Caso de uso 5 - Listado y reporte de Marianela Montalvo",
      "item": [
        {
          "name": "Listado de movimientos por fechas x usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{cuentasUrl}}/movimientos?cliente={{marianelaId}}&fecha={{hoy}},{{hoy}}",
              "host": [
                "{{cuentasUrl}}"
              ],
              "path": [
                "movimientos"
              ],
              "query": [
                {
                  "key": "cliente",
                  "value": "{{marianelaId}}"
                },
                {
                  "key": "fecha",
                  "value": "{{hoy}},{{hoy}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha de hoy en la zona horaria del banco (America/Guayaquil, UTC-5 sin horario de verano)",
                  "pm.collectionVariables.set('hoy', new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('totalElementos = 2', () => pm.expect(pm.response.json().totalElementos).to.eql(2));",
                  "pm.test('Filas planas con el cliente', () => pm.response.json().contenido.forEach(f => pm.expect(f.nombreCliente).to.eql('Marianela Montalvo')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reporte de estado de cuenta (F4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{cuentasUrl}}/reportes?fecha={{hoy}},{{hoy}}&cliente={{marianelaId}}",
              "host": [
                "{{cuentasUrl}}"
              ],
              "path": [
                "reportes"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "{{hoy}},{{hoy}}"
                },
                {
                  "key": "cliente",
                  "value": "{{marianelaId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha de hoy en la zona horaria del banco (America/Guayaquil, UTC-5 sin horario de verano)",
                  "pm.collectionVariables.set('hoy', new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const cuentas = pm.response.json().cuentas;",
                  "const de = numero => cuentas.find(c => c.numeroCuenta === numero);",
                  "pm.test('2 cuentas', () => pm.expect(cuentas).to.have.lengthOf(2));",
                  "pm.test('225487: saldo 700, depósito 600', () => { pm.expect(de('225487').saldoDisponible).to.eql(700); pm.expect(de('225487').movimientos[0].valor).to.eql(600); });",
                  "pm.test('496825: saldo 0, retiro 540', () => { pm.expect(de('496825').saldoDisponible).to.eql(0); pm.expect(de('496825').movimientos[0].valor).to.eql(-540); });"
                ]
              }
            }
          ]
        }
      ]
    },
