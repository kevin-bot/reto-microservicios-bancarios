{
  "info": {
    "name": "Reto banco - E2E (ms-clientes + ms-cuentas)",
    "description": "Casos de uso 1 a 5 del enunciado de punta a punta entre ambos microservicios. Ejecutar en orden con el Collection Runner sobre una base limpia: `docker compose down -v && docker compose up -d --build` (los números de cuenta del enunciado son fijos; repetir sin limpiar da 409).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Caso de uso 1 - Creación de usuarios (ms-clientes)",
      "item": [
        {
          "name": "Crear Jose Lema",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{clientesUrl}}/clientes",
              "host": [
                "{{clientesUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jose Lema\",\n  \"genero\": \"MASCULINO\",\n  \"edad\": 35,\n  \"identificacion\": \"{{joseIdentificacion}}\",\n  \"direccion\": \"Otavalo sn y principal\",\n  \"telefono\": \"098254785\",\n  \"contrasena\": \"1234\",\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('joseIdentificacion', '17' + Date.now().toString().slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('No expone la contraseña', () => pm.expect(pm.response.json()).to.not.have.property('contrasena'));",
                  "pm.collectionVariables.set('joseId', pm.response.json().clienteId);"
                ]
              }
            }
          ]
        },
