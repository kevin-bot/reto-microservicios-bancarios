    {
      "name": "2. Escenarios CRUD (quickstart)",
      "item": [
        {
          "name": "Crear cliente temporal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Temporal\",\n  \"genero\": \"OTRO\",\n  \"edad\": 28,\n  \"identificacion\": \"{{temporalIdentificacion}}\",\n  \"direccion\": \"Quito centro\",\n  \"telefono\": \"0991234567\",\n  \"contrasena\": \"clave1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('temporalIdentificacion', 'T' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('No expone la contraseña', () => pm.expect(pm.response.json()).to.not.have.property('contrasena'));",
                  "pm.test('Header Location', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/clientes/'));",
                  "pm.collectionVariables.set('temporalId', pm.response.json().clienteId);"
                ]
              }
            }
          ]
        },
